{
  "expo": {
    "name": "Ojarket",
    "slug": "ojarket",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/Ojarket_05_AppIcon_Master_1024_Transparent.png",
    "userInterfaceStyle": "automatic",
    "scheme": "ojarket",
    "splash": {
      "image": "./assets/brand/Ojarket_05_AppIcon_Master_1024_Transparent.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D2E26"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ojarket.app"
    },
    "android": {
      "package": "com.ojarket.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/Ojarket_05_AppIcon_Master_1024_Transparent.png",
        "backgroundColor": "#0D2E26"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/brand/Ojarket_04_Favicon_512_Transparent.png"
    },
    "extra": {
      "eas": {
        "projectId": "dc02cba8-0675-47f9-826d-1dad3de32b27"
      }
    },
    "owner": "scriptura",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Ojarket a besoin d'accéder à l'appareil photo pour photographier vos créations et scanner les codes de vérification."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ojarket a besoin d'accéder à vos photos pour enrichir le catalogue de votre atelier."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Ojarket utilise votre position pour vous afficher les ateliers et créateurs d'artisanat les plus proches à Cotonou et au Bénin."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/Ojarket_01_Icon_UltraPremium_Transparent.png",
          "color": "#C5A059"
        }
      ]
    ]
  }
}
