generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==============================================================================
// 1. IDENTITY & MULTI-TENANT
// ==============================================================================

enum UserRole {
  BUYER
  SELLER
  ADMIN
  OPERATOR
}

model User {
  id                  String           @id @default(uuid())
  name                String
  email               String           @unique
  emailVerified       Boolean          @default(false)
  image               String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  // Better Auth plugin fields
  username            String?          @unique
  displayUsername     String?
  phoneNumber         String?
  phoneNumberVerified Boolean          @default(false)

  // Custom Ojarket fields
  phone               String?
  passwordHash        String?
  googleId            String?          @unique
  avatarUrl           String?
  isEmailVerified     Boolean          @default(false)
  role                UserRole         @default(BUYER)
  locale              String           @default("fr")

  // Relations
  sessions            Session[]
  accounts            Account[]
  ownedShops          Shop[]           @relation("ShopOwner")
  memberships         ShopMembership[]
  requests            PurchaseRequest[]
  orders              Order[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

model Shop {
  id            String           @id @default(uuid())
  slug          String           @unique
  name          String
  description   String?
  craftType     String?
  city          String           @default("Cotonou")
  country       String           @default("Bénin")
  currency      String           @default("XOF")
  isVerified    Boolean          @default(false)
  kycStatus     KycStatus        @default(PENDING)
  kycNotes      String?
  ownerId       String
  owner         User             @relation("ShopOwner", fields: [ownerId], references: [id])
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  memberships   ShopMembership[]
  products      Product[]
  proposals     SellerProposal[]
  orders        Order[]
  cashbook      CashbookEntry[]
  dayClosures   DayClosure[]
  paymentConnections ShopPaymentConnection[]
  subscriptions      Subscription[]

  @@map("shops")
}

enum ShopRole {
  OWNER
  MANAGER
  STAFF
}

model ShopMembership {
  id        String   @id @default(uuid())
  shopId    String
  userId    String
  role      ShopRole @default(STAFF)
  createdAt DateTime @default(now())

  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shopId, userId])
  @@map("shop_memberships")
}

// ==============================================================================
// 2. CATALOG & INVENTORY (D01)
// ==============================================================================

model Product {
  id          String         @id @default(uuid())
  shopId      String
  title       String
  description String
  category    String
  originCity  String         @default("Cotonou")
  isPublished Boolean        @default(true)
  images      String[]
  variants    OfferVariant[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  shop        Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("products")
}

model OfferVariant {
  id              String           @id @default(uuid())
  productId       String
  sku             String           @unique
  name            String
  priceMinor      Int
  currency        String           @default("XOF")
  stockOnHand     Int              @default(0)
  stockReserved   Int              @default(0)
  isAvailable     Boolean          @default(true)
  specifications  Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  reservations    Reservation[]
  stockMovements  StockMovement[]
  orderLines      OrderLine[]
  proposals       SellerProposal[]

  @@map("offer_variants")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  EXPIRED
  CANCELLED
}

model Reservation {
  id          String            @id @default(uuid())
  variantId   String
  orderId     String?
  quantity    Int               @default(1)
  status      ReservationStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime          @default(now())

  variant     OfferVariant      @relation(fields: [variantId], references: [id])
  order       Order?            @relation(fields: [orderId], references: [id])

  @@map("reservations")
}

enum MovementReason {
  SALE
  INVENTORY_ADJUSTMENT
  RETURN
  RESERVATION_HOLD
  RESERVATION_RELEASE
}

model StockMovement {
  id          String         @id @default(uuid())
  variantId   String
  delta       Int
  reason      MovementReason
  reference   String?
  createdAt   DateTime       @default(now())

  variant     OfferVariant   @relation(fields: [variantId], references: [id])

  @@map("stock_movements")
}

// ==============================================================================
// 3. BESPOKE NEEDS & MATCHING (D02)
// ==============================================================================

enum RequestStatus {
  OPEN
  IN_REVIEW
  MATCHED
  FULFILLED
  CLOSED
  EXPIRED
}

model PurchaseRequest {
  id                 String           @id @default(uuid())
  buyerId            String
  title              String
  description        String
  category           String
  targetBudgetMinor  Int?
  currency           String           @default("XOF")
  maxDeliveryDate    DateTime?
  status             RequestStatus    @default(OPEN)
  aiStructuredData   Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  buyer              User             @relation(fields: [buyerId], references: [id])
  proposals          SellerProposal[]

  @@map("purchase_requests")
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

model SellerProposal {
  id                          String          @id @default(uuid())
  requestId                   String
  shopId                      String
  offerVariantId              String?
  priceMinor                  Int
  advancePaymentRequiredMinor Int             @default(0)
  currency                    String          @default("XOF")
  productionDays              Int             @default(7)
  proposalNotes               String
  status                      ProposalStatus  @default(PENDING)
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt

  request                     PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  shop                        Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  variant                     OfferVariant?   @relation(fields: [offerVariantId], references: [id])

  @@map("seller_proposals")
}

// ==============================================================================
// 4. ORDERS & FULFILLMENT (MERCHANT-OWNED)
// ==============================================================================

enum PaymentStatus {
  NOT_STARTED
  DECLARED
  PENDING
  PARTIALLY_PAID
  CONFIRMED
  FAILED
  REFUND_PENDING
  REFUNDED
  CANCELLED
  REVIEW_REQUIRED
}

enum VerificationSource {
  PROVIDER
  SELLER_MANUAL
  COD
  PICKUP
  BANK_MANUAL
  UNKNOWN
}

enum FulfillmentStatus {
  PENDING
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentChannel {
  MTN_MOMO
  MOOV_MONEY
  CELTIIS_CASH
  CARD
  DIRECT_TRANSFER
  CASH_ON_DELIVERY
  PICKUP
}

model Order {
  id                     String             @id @default(uuid())
  shopId                 String
  buyerId                String
  orderNumber            String             @unique
  totalAmountMinor       Int
  grossSaleAmountMinor   Int
  amountReceivedMinor    Int                @default(0)
  amountOutstandingMinor Int                @default(0)
  refundAmountMinor      Int                @default(0)
  netCollectedMinor      Int                @default(0)
  currency               String             @default("XOF")
  paymentStatus          PaymentStatus      @default(PENDING)
  verificationSource     VerificationSource @default(UNKNOWN)
  fulfillmentStatus      FulfillmentStatus  @default(PENDING)
  paymentChannel         PaymentChannel     @default(MTN_MOMO)
  isDigital              Boolean            @default(false)
  deliveryAddress        String?
  notes                  String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  shop                   Shop               @relation(fields: [shopId], references: [id])
  buyer                  User               @relation(fields: [buyerId], references: [id])
  lines                  OrderLine[]
  reservations           Reservation[]
  financialEvents        FinancialEvent[]
  digitalEntitlements    DigitalEntitlement[]
  incidents              OrderIncident[]

  @@map("orders")
}

model OrderLine {
  id              String       @id @default(uuid())
  orderId         String
  variantId       String
  itemTitle       String
  quantity        Int          @default(1)
  unitPriceMinor  Int
  currency        String       @default("XOF")

  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant         OfferVariant @relation(fields: [variantId], references: [id])

  @@map("order_lines")
}

model ShopPaymentConnection {
  id             String         @id @default(uuid())
  shopId         String
  channel        PaymentChannel
  merchantPhone  String?
  merchantNumber String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())

  shop           Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, channel])
  @@map("shop_payment_connections")
}

// ==============================================================================
// 5. MERCHANT FINANCIAL OPERATIONS & IMMUTABLE CASHBOOK (S43 - S47)
// ==============================================================================

enum EntryType {
  ENCAISSEMENT
  DECAISSEMENT
  VENTE_A_CREDIT
}

enum FinancialEventType {
  SALE_CREATED
  PAYMENT_DECLARED
  PAYMENT_CONFIRMED
  PARTIAL_PAYMENT_CONFIRMED
  COD_COLLECTED
  REFUND_REQUESTED
  REFUND_CONFIRMED
  ADJUSTMENT_POSTED
  DAY_CLOSED
}

model FinancialEvent {
  id          String             @id @default(uuid())
  shopId      String
  orderId     String?
  eventType   FinancialEventType
  amountMinor Int
  currency    String             @default("XOF")
  source      VerificationSource @default(SELLER_MANUAL)
  channel     PaymentChannel     @default(MTN_MOMO)
  reference   String?
  notes       String?
  createdAt   DateTime           @default(now())

  order       Order?             @relation(fields: [orderId], references: [id])

  @@map("financial_events")
}

model CashbookEntry {
  id            String             @id @default(uuid())
  shopId        String
  type          EntryType
  amountMinor   Int
  currency      String             @default("XOF")
  channel       PaymentChannel     @default(MTN_MOMO)
  reference     String
  notes         String?
  entryDate     DateTime           @default(now())
  dayClosureId  String?

  shop          Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  dayClosure    DayClosure?        @relation(fields: [dayClosureId], references: [id])

  @@map("cashbook_entries")
}

model DayClosure {
  id                 String          @id @default(uuid())
  shopId             String
  closureDate        DateTime
  totalVenduMinor    Int
  totalEncaisseMinor Int
  totalRestantMinor  Int
  varianceMinor      Int             @default(0)
  closedBy           String
  status             String          @default("BALANCED")
  breakdown          Json?
  auditNotes         String?
  closedAt           DateTime        @default(now())

  shop               Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  entries            CashbookEntry[]

  @@unique([shopId, closureDate])
  @@map("day_closures")
}

// ==============================================================================
// 6. DIGITAL ASSETS & LICENSES (FR-42 to FR-47)
// ==============================================================================

model DigitalAsset {
  id              String               @id @default(uuid())
  title           String
  fileUrl         String
  fileSize        Int
  mimeType        String
  checksum        String
  version         String               @default("1.0.0")
  isPublicPreview Boolean              @default(false)
  createdAt       DateTime             @default(now())

  entitlements    DigitalEntitlement[]

  @@map("digital_assets")
}

model DigitalEntitlement {
  id             String        @id @default(uuid())
  userId         String
  orderId        String
  digitalAssetId String
  status         String        @default("ACTIVE")
  downloadCount  Int           @default(0)
  maxDownloads   Int           @default(10)
  expiresAt      DateTime?
  createdAt      DateTime      @default(now())

  order          Order         @relation(fields: [orderId], references: [id])
  asset          DigitalAsset  @relation(fields: [digitalAssetId], references: [id])

  @@map("digital_entitlements")
}

// ==============================================================================
// 7. CENTRAL ADMINISTRATION DOMAIN (03B_ADMINISTRATION)
// ==============================================================================

enum AdminRole {
  PLATFORM_OWNER
  OPERATIONS_ADMIN
  MERCHANT_REVIEWER
  CONTENT_MODERATOR
  FINANCE_OPERATOR
  TECH_OPERATOR
}

model AdminUser {
  id         String      @id @default(uuid())
  email      String      @unique
  name       String
  role       AdminRole   @default(OPERATIONS_ADMIN)
  mfaEnabled Boolean     @default(true)
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())

  auditLogs  AdminAuditLog[]

  @@map("admin_users")
}

model AdminAuditLog {
  id             String    @id @default(uuid())
  adminId        String
  action         String
  targetResource String
  targetId       String
  beforeState    Json?
  afterState     Json?
  ipAddress      String?
  createdAt      DateTime  @default(now())

  admin          AdminUser @relation(fields: [adminId], references: [id])

  @@map("admin_audit_logs")
}

model PaymentCorridorRule {
  id                String         @id @default(uuid())
  countryCode       String         @default("BJ")
  currency          String         @default("XOF")
  channel           PaymentChannel
  isEnabled         Boolean        @default(false)
  denyByDefault     Boolean        @default(true)
  requiredKycLevel  String         @default("STANDARD")
  minAmountMinor    Int            @default(100)
  maxAmountMinor    Int            @default(500000000)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([countryCode, channel])
  @@map("payment_corridor_rules")
}

model OtpToken {
  id         String   @id @default(uuid())
  identifier String
  code       String
  expiresAt  DateTime
  used       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([identifier])
  @@map("otp_tokens")
}

// ==============================================================================
// 8. DISPUTES & INCIDENT MANAGEMENT (FR-52 to FR-55)
// ==============================================================================

enum IncidentCategory {
  DAMAGED_ITEM
  DEFECTIVE_CRAFT
  NON_CONFORMING
  DELAY_EXCEEDED
  UNDELIVERED
  DIGITAL_ACCESS_ISSUE
  OTHER
}

enum IncidentStatus {
  OPEN
  UNDER_REVIEW
  ACTION_REQUIRED
  PROPOSAL_MADE
  RESOLVED
  CONTESTED
  CLOSED
}

model OrderIncident {
  id              String           @id @default(uuid())
  orderId         String
  reporterName    String
  reporterPhone   String?
  category        IncidentCategory @default(OTHER)
  title           String
  description     String
  evidenceUrls    String[]
  status          IncidentStatus   @default(OPEN)
  resolution      String?
  proposedOutcome String?
  resolvedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_incidents")
}

// ==============================================================================
// 9. MERCHANT SAAS SUBSCRIPTIONS & MONETIZATION (FR-37)
// ==============================================================================

enum PlanTier {
  DECOUVERTE_FREE
  ATELIER_PRO
  MAISON_D_ART_PRESTIGE
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  PAST_DUE
  CANCELED
  EXPIRED
}

enum BillingSource {
  MONEROO
  MTN_MOMO
  MOOV_MONEY
  PLAY_BILLING
  WEB_DIRECT
  MANUAL_ADMIN
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

model Subscription {
  id                 String             @id @default(uuid())
  shopId             String
  planTier           PlanTier           @default(DECOUVERTE_FREE)
  status             SubscriptionStatus @default(ACTIVE)
  billingSource      BillingSource      @default(MTN_MOMO)
  billingInterval    BillingInterval    @default(MONTHLY)
  priceMinor         Int                @default(0)
  currency           String             @default("XOF")
  maxProducts        Int                @default(5)
  hasPriorityD02     Boolean            @default(false)
  hasFecExport       Boolean            @default(false)
  hasVipConcierge    Boolean            @default(false)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  externalPaymentRef String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  shop               Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}


