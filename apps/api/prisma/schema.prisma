generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==============================================================================
// 1. IDENTITY & MULTI-TENANT
// ==============================================================================

enum UserRole {
  BUYER
  SELLER
  ADMIN
  OPERATOR
}

model User {
  id            String           @id @default(uuid())
  email         String           @unique
  phone         String?
  name          String
  role          UserRole         @default(BUYER)
  locale        String           @default("fr")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  ownedShops    Shop[]           @relation("ShopOwner")
  memberships   ShopMembership[]
  requests      PurchaseRequest[]
  orders        Order[]

  @@map("users")
}

model Shop {
  id            String           @id @default(uuid())
  slug          String           @unique
  name          String
  description   String?
  craftType     String?
  city          String           @default("Cotonou")
  country       String           @default("Bénin")
  currency      String           @default("XOF")
  isVerified    Boolean          @default(false)
  ownerId       String
  owner         User             @relation("ShopOwner", fields: [ownerId], references: [id])
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  memberships   ShopMembership[]
  products      Product[]
  proposals     SellerProposal[]
  orders        Order[]
  cashbook      CashbookEntry[]
  dayClosures   DayClosure[]
  paymentConnections ShopPaymentConnection[]

  @@map("shops")
}

enum ShopRole {
  OWNER
  MANAGER
  STAFF
}

model ShopMembership {
  id        String   @id @default(uuid())
  shopId    String
  userId    String
  role      ShopRole @default(STAFF)
  createdAt DateTime @default(now())

  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shopId, userId])
  @@map("shop_memberships")
}

// ==============================================================================
// 2. CATALOG & INVENTORY (D01)
// ==============================================================================

model Product {
  id          String         @id @default(uuid())
  shopId      String
  title       String
  description String
  category    String
  originCity  String         @default("Cotonou")
  isPublished Boolean        @default(true)
  images      String[]
  variants    OfferVariant[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  shop        Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("products")
}

model OfferVariant {
  id              String           @id @default(uuid())
  productId       String
  sku             String           @unique
  name            String
  priceMinor      Int
  currency        String           @default("XOF")
  stockOnHand     Int              @default(0)
  stockReserved   Int              @default(0)
  isAvailable     Boolean          @default(true)
  specifications  Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  reservations    Reservation[]
  stockMovements  StockMovement[]
  orderLines      OrderLine[]
  proposals       SellerProposal[]

  @@map("offer_variants")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  EXPIRED
  CANCELLED
}

model Reservation {
  id          String            @id @default(uuid())
  variantId   String
  orderId     String?
  quantity    Int               @default(1)
  status      ReservationStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime          @default(now())

  variant     OfferVariant      @relation(fields: [variantId], references: [id])
  order       Order?            @relation(fields: [orderId], references: [id])

  @@map("reservations")
}

enum MovementReason {
  SALE
  INVENTORY_ADJUSTMENT
  RETURN
  RESERVATION_HOLD
  RESERVATION_RELEASE
}

model StockMovement {
  id          String         @id @default(uuid())
  variantId   String
  delta       Int
  reason      MovementReason
  reference   String?
  createdAt   DateTime       @default(now())

  variant     OfferVariant   @relation(fields: [variantId], references: [id])

  @@map("stock_movements")
}

// ==============================================================================
// 3. BESPOKE NEEDS & MATCHING (D02)
// ==============================================================================

enum RequestStatus {
  OPEN
  IN_REVIEW
  MATCHED
  FULFILLED
  CLOSED
  EXPIRED
}

model PurchaseRequest {
  id                 String           @id @default(uuid())
  buyerId            String
  title              String
  description        String
  category           String
  targetBudgetMinor  Int?
  currency           String           @default("XOF")
  maxDeliveryDate    DateTime?
  status             RequestStatus    @default(OPEN)
  aiStructuredData   Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  buyer              User             @relation(fields: [buyerId], references: [id])
  proposals          SellerProposal[]

  @@map("purchase_requests")
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

model SellerProposal {
  id                 String          @id @default(uuid())
  requestId          String
  shopId             String
  offerVariantId     String?
  priceMinor         Int
  currency           String          @default("XOF")
  productionDays     Int             @default(7)
  proposalNotes      String
  status             ProposalStatus  @default(PENDING)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  request            PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  shop               Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  variant            OfferVariant?   @relation(fields: [offerVariantId], references: [id])

  @@map("seller_proposals")
}

// ==============================================================================
// 4. ORDERS & FULFILLMENT (MERCHANT-OWNED)
// ==============================================================================

enum PaymentStatus {
  PENDING
  SETTLED_TO_MERCHANT
  FAILED
  REFUNDED
}

enum FulfillmentStatus {
  PENDING
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentChannel {
  MTN_MOMO
  MOOV_MONEY
  CELTIIS_CASH
  CARD
  DIRECT_TRANSFER
  CASH_ON_DELIVERY
}

model Order {
  id                String            @id @default(uuid())
  shopId            String
  buyerId           String
  orderNumber       String            @unique
  totalAmountMinor  Int
  currency          String            @default("XOF")
  paymentStatus     PaymentStatus     @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(PENDING)
  paymentChannel    PaymentChannel    @default(MTN_MOMO)
  deliveryAddress   String?
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  shop              Shop              @relation(fields: [shopId], references: [id])
  buyer             User              @relation(fields: [buyerId], references: [id])
  lines             OrderLine[]
  reservations      Reservation[]

  @@map("orders")
}

model OrderLine {
  id              String       @id @default(uuid())
  orderId         String
  variantId       String
  itemTitle       String
  quantity        Int          @default(1)
  unitPriceMinor  Int
  currency        String       @default("XOF")

  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant         OfferVariant @relation(fields: [variantId], references: [id])

  @@map("order_lines")
}

model ShopPaymentConnection {
  id             String         @id @default(uuid())
  shopId         String
  channel        PaymentChannel
  merchantPhone  String?
  merchantNumber String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())

  shop           Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, channel])
  @@map("shop_payment_connections")
}

// ==============================================================================
// 5. FINOPS CASHBOOK & DAY CLOSURES (S43 / S44)
// ==============================================================================

enum EntryType {
  ENCAISSEMENT
  DECAISSEMENT
  VENTE_A_CREDIT
}

model CashbookEntry {
  id            String         @id @default(uuid())
  shopId        String
  type          EntryType
  amountMinor   Int
  currency      String         @default("XOF")
  channel       PaymentChannel @default(MTN_MOMO)
  reference     String
  notes         String?
  entryDate     DateTime       @default(now())
  dayClosureId  String?

  shop          Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  dayClosure    DayClosure?    @relation(fields: [dayClosureId], references: [id])

  @@map("cashbook_entries")
}

model DayClosure {
  id                String          @id @default(uuid())
  shopId            String
  closureDate       DateTime
  totalVenduMinor   Int
  totalEncaisseMinor Int
  totalRestantMinor Int
  varianceMinor     Int             @default(0)
  closedBy          String
  status            String          @default("BALANCED")
  notes             String?
  closedAt          DateTime        @default(now())

  shop              Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  entries           CashbookEntry[]

  @@unique([shopId, closureDate])
  @@map("day_closures")
}

