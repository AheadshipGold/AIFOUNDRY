# ==============================================================================
# MOTEURS IA & TRANSCRIPTION VOCALE (SPEECH-TO-TEXT)
# ==============================================================================

# 1. Groq Whisper (Recommandé : ultra-rapide ~200ms, gratuit / très économique)
# Obtenez une clé gratuite sur : https://console.groq.com/keys
GROQ_API_KEY=""

# 2. Google Cloud Speech-to-Text v1 REST
# Clé API Google Cloud Console avec l'API Speech-to-Text activée
GOOGLE_SPEECH_API_KEY=""

# 3. Google Gemini API (Moteur IA génératif)
# Obtenez une clé sur : https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# 4. OpenAI API (Optionnel pour Whisper / GPT)
OPENAI_API_KEY=""

# ==============================================================================
